  <diagram id="warung-pak-din-order-flow" name="Alur Pemesanan">
    <mxGraphModel dx="1320" dy="2040" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1320" pageHeight="2040" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="start" value="Mulai pesanan" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#dbeafe;strokeColor=#2563eb;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="560" y="30" width="200" height="60" as="geometry" /></mxCell>
        <mxCell id="init" value="Inisialisasi&#xa;jumlahPesanan = 0&#xa;totalItem = 0; totalBelanja = 0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;fontSize=14;" vertex="1" parent="1"><mxGeometry x="490" y="125" width="340" height="90" as="geometry" /></mxCell>
        <mxCell id="customer" value="Input namaPelanggan" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;fontSize=14;" vertex="1" parent="1"><mxGeometry x="535" y="250" width="250" height="60" as="geometry" /></mxCell>
        <mxCell id="manage" value="Menu kelola pesanan&#xa;1 Tambah   2 Lihat   3 Edit&#xa;4 Selesai   5 Batalkan" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="455" y="345" width="410" height="90" as="geometry" /></mxCell>
        <mxCell id="choice" value="pilihanPesan?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="575" y="470" width="170" height="120" as="geometry" /></mxCell>
        <mxCell id="add" value="1. Tambah pesanan&#xa;Validasi batas 100, menu 1-30, dan jumlah &gt; 0&#xa;Hitung subtotal, simpan ke array, perbarui total" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#059669;fontSize=13;" vertex="1" parent="1"><mxGeometry x="45" y="665" width="340" height="115" as="geometry" /></mxCell>
        <mxCell id="view" value="2. Lihat pesanan&#xa;Tampilkan setiap menu, jumlah, subtotal, dan total" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#059669;fontSize=13;" vertex="1" parent="1"><mxGeometry x="440" y="665" width="320" height="90" as="geometry" /></mxCell>
        <mxCell id="edit" value="3. Edit pesanan&#xa;Validasi nomor dan jumlah pengurangan&#xa;Perbarui subtotal/total; hapus jika jumlah 0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#059669;fontSize=13;" vertex="1" parent="1"><mxGeometry x="815" y="665" width="350" height="115" as="geometry" /></mxCell>
        <mxCell id="cancel" value="5. Batalkan pesanan&#xa;Pilih nomor record yang dibatalkan&#xa;Kurangi jumlah dan subtotal dari total&#xa;Hapus record lalu rapatkan array" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#ea580c;fontSize=13;" vertex="1" parent="1"><mxGeometry x="400" y="840" width="340" height="115" as="geometry" /></mxCell>
        <mxCell id="has-orders" value="jumlahPesanan = 0?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1000" y="840" width="190" height="130" as="geometry" /></mxCell>
        <mxCell id="empty" value="Pesanan kosong&#xa;Tampilkan pesan, kembali ke menu" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#ea580c;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1000" y="1030" width="190" height="80" as="geometry" /></mxCell>
        <mxCell id="summary" value="Ringkasan pesanan&#xa;Tampilkan semua baris, total item, dan total belanja" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;fontSize=14;" vertex="1" parent="1"><mxGeometry x="505" y="1020" width="310" height="90" as="geometry" /></mxCell>
        <mxCell id="summary-choice" value="Lanjut pembayaran?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="575" y="1170" width="170" height="120" as="geometry" /></mxCell>
        <mxCell id="payment" value="Input uangBayar" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;fontSize=14;" vertex="1" parent="1"><mxGeometry x="545" y="1350" width="230" height="60" as="geometry" /></mxCell>
        <mxCell id="enough" value="uangBayar &gt;= totalBelanja?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="560" y="1470" width="200" height="130" as="geometry" /></mxCell>
        <mxCell id="change" value="Hitung kembalian&#xa;kembalian = uangBayar - totalBelanja" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#059669;fontSize=14;" vertex="1" parent="1"><mxGeometry x="510" y="1670" width="300" height="75" as="geometry" /></mxCell>
